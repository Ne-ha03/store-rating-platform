# Copy this file to .env and fill in your own values before running the server

PORT=5000

# Postgres connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=store_ratings
PGUSER=postgres
PGPASSWORD=postgres

# Used to sign login tokens - swap this for a long random string in production
JWT_SECRET=change_this_to_something_long_and_random
JWT_EXPIRES_IN=7d
